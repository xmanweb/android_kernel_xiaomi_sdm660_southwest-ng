CONFIG_MACH_XIAOMI=y
CONFIG_MACH_XIAOMI_SDM660=y
CONFIG_MACH_LONGCHEER=y
CONFIG_MACH_XIAOMI_WHYRED=y

# CONFIG_UCLAMP_TASK is not set
# CONFIG_CFI_CLANG is not set
# CONFIG_SHADOW_CALL_STACK is not set
# CONFIG_VMAP_STACK is not set

CONFIG_MODULES=y

# CONFIG_XDP_SOCKETS is not set
# CONFIG_USB_RTL8150 is not set

CONFIG_INPUT_HALL_SENSOR_E7S=y
CONFIG_TOUCHSCREEN_NVT_E7S=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_E7S=y
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_FORCE is not set

CONFIG_INPUT_QTI_HAPTICS=y

CONFIG_SND_SOC_TAS2557=y

CONFIG_MSMB_CAMERA_LEGACY=y

CONFIG_FB_MSM_MDSS_KCAL_CTRL=y

CONFIG_BACKLIGHT_QCOM_SPMI_WLED=y

# CONFIG_F2FS_UNFAIR_RWSEM is not set
# CONFIG_STACKTRACE is not set
# CONFIG_FTRACE is not set

CONFIG_BUG_ON_DATA_CORRUPTION=y
# CONFIG_PANIC_ON_DATA_CORRUPTION is not set

CONFIG_DEBUG_ALIGN_RODATA=y
