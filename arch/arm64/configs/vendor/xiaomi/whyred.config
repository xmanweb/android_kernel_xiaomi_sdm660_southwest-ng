# Platform
CONFIG_MACH_XIAOMI_WHYRED=y

# Camera
CONFIG_MSMB_CAMERA_LEGACY=y

# Hall sensor
CONFIG_INPUT_HALL_SENSOR_E7S=y

# Touchscreen
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_NVT_E7S=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_E7S=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_E7S_CORE=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_E7S_I2C=y

# --- 补齐高通音频时钟与通信握手（解决 ADSP 未加载死锁） ---
CONFIG_MSM_AVTIMER=y
CONFIG_AVTIMER_LEGACY=y
CONFIG_SND_SOC_CPE=y
CONFIG_SND_SOC_WCD_CPE=y

# --- 补齐小米 sdm660 必备的外置功放驱动 ---
CONFIG_SND_SOC_TAS2557=y
CONFIG_TAS2557_REGMAP=y
CONFIG_TAS2557_CODEC=y
CONFIG_TAS2557_MISC=y
CONFIG_SOUND_CONTROL=y

# --- 补齐内核基础优化与内存安全配置 ---
CONFIG_JUMP_LABEL=y
CONFIG_ARCH_MMAP_RND_BITS=24
CONFIG_ARCH_MMAP_RND_COMPAT_BITS=16

CONFIG_INPUT_TOUCHSCREEN=y
# CONFIG_TOUCHSCREEN_ST is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX is not set
CONFIG_TOUCHSCREEN_NVT_E7S=y
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM is not set
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_E7S=y

# --- 高通子系统核心加载与外设固件引导（核心修复项） ---
CONFIG_MSM_SUBSYSTEM_RESTART=y
CONFIG_MSM_PIL=y
CONFIG_MSM_PIL_SSR_GENERIC=y
CONFIG_MSM_BOOT_STATS=y

# 关掉以下这几项，切断对 msm_tdm / msm_mi2s / msm_common 的引用
CONFIG_SND_SOC_MSM_QDSP6V2_INTF=n
CONFIG_SND_SOC_QDSP6V2=n
CONFIG_MSM_QDSP6V2_CODECS=n
CONFIG_AUDIO_EXT_CLK=n

# --- 临时屏蔽高通原生声卡驱动，强制跳过音频死锁，先跑通开开机流程 ---
CONFIG_SND_SOC_SDM660=n
CONFIG_SND_SOC_SDM660_CDC=n
